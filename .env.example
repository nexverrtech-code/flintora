# Production domain (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://flintora.com

# Contact form: Web3Forms access key (https://web3forms.com). Without it the form falls back to opening an email draft.
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
PUBLIC_GA_ID=

# Google Search Console verification token (content of the meta tag). Optional.
PUBLIC_GSC_VERIFICATION=
