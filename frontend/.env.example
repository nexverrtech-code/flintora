# All values are public build-time settings (set them as build variables in Cloudflare).
# Leave any of them empty to hide that item everywhere, including structured data.

# Production domain, used for canonical URLs, Open Graph, sitemap and structured data.
VITE_SITE_URL=https://flintora.nexverrtech.com

# ---- Contact form -------------------------------------------------------------
# Web3Forms access key (free at https://web3forms.com, register it with the inbox that should
# receive enquiries). With a key the Contact form emails enquiries directly.
# Without a key the form opens the visitor's email app addressed to VITE_CONTACT_EMAIL.
VITE_WEB3FORMS_KEY=

# ---- Verified contact details -------------------------------------------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# WhatsApp number, digits only with country code (e.g. 919876543210).
VITE_WHATSAPP_NUMBER=

# ---- Address (must match your Google Business Profile exactly) ---------------
VITE_ADDRESS_STREET=
VITE_ADDRESS_CITY=
VITE_ADDRESS_REGION=
VITE_ADDRESS_POSTCODE=
VITE_ADDRESS_COUNTRY=

# ---- Local search / Google Business Profile ------------------------------------
# Comma-separated places you serve, e.g. "Chennai, Tamil Nadu, India"
VITE_SERVICE_AREA=
# Coordinates of the office (decimal degrees)
VITE_GEO_LAT=
VITE_GEO_LNG=
# schema.org opening hours, comma-separated, e.g. "Mo-Fr 09:30-18:30, Sa 10:00-14:00"
VITE_OPENING_HOURS=
# Your Google Business Profile link (g.page/... or maps.app.goo.gl/...) and Google Maps link
VITE_GOOGLE_BUSINESS_URL=
VITE_GOOGLE_MAPS_URL=

# ---- Search console verification (content value of the meta tag only) ----------
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

# ---- Verified social profiles (full URLs) --------------------------------------
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_BEHANCE=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Budget field currency on the contact form
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
