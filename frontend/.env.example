# All values are public build-time settings. Leave any of them empty to hide that channel.

# Production domain, used for canonical URLs, Open Graph, sitemap and structured data.
VITE_SITE_URL=https://flintora.com

# Verified contact details. Nothing is shown on the site until these are set.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# WhatsApp number, digits only with country code (e.g. 919876543210). Enables "Continue on WhatsApp".
VITE_WHATSAPP_NUMBER=
# Optional external enquiry form (Google Form, Typeform, Tally...). Enables "Open enquiry form".
VITE_ENQUIRY_URL=

# Verified address (optional). Used on Contact and in structured data.
VITE_ADDRESS_STREET=
VITE_ADDRESS_CITY=
VITE_ADDRESS_REGION=
VITE_ADDRESS_POSTCODE=
VITE_ADDRESS_COUNTRY=

# Verified social profiles (full URLs). Empty entries are hidden.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_BEHANCE=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Budget estimator currency (ISO code) and locale for number formatting.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
