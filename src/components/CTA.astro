---
import SplitHeading from './SplitHeading.astro';
import SparkMark from './SparkMark.astro';
import Icon from './Icon.astro';
interface Props { lines?: string[]; text?: string }
const { lines = ['Ready to', 'strike a spark.'], text = 'Tell us where you want to grow. We will reply within one working day with honest next steps.' } = Astro.props;
---
<section class="section cta" data-scroll-progress>
  <div class="container">
    <div class="cta__box" data-reveal>
      <div class="cta__mark" aria-hidden="true" data-parallax="0.3" data-parallax-rotate="-20"><SparkMark /></div>
      <p class="eyebrow">Start a project</p>
      <SplitHeading lines={lines} class="h1" />
      <p class="lead">{text}</p>
      <div class="cta__actions">
        <a href="/contact/" class="btn" data-magnetic>Book a free strategy call <Icon name="arrow" /></a>
        <a href="/services/" class="btn btn--ghost">Explore services</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta__box { position: relative; overflow: hidden; border-radius: calc(var(--radius) * 2); padding: clamp(2rem, 1rem + 5vw, 5.5rem);
    background: radial-gradient(120% 140% at 100% 0%, rgba(255,128,13,.28), rgba(255,128,13,0) 55%), var(--surface); border: 1px solid var(--line); }
  .cta__box .h1 { max-width: 14ch; margin-bottom: 1.25rem; position: relative; }
  .cta__box .lead { max-width: 44ch; position: relative; }
  .cta__mark { position: absolute; right: 3%; top: 50%; translate: 0 -50%; width: clamp(90px, 12vw, 180px); opacity: .9; filter: drop-shadow(0 30px 60px rgba(255,128,13,.4)); }
  .cta__mark :global(svg) { width: 100%; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; position: relative; }
  @media (max-width: 1100px) { .cta__mark { opacity: .3; right: -4%; } }
</style>
