---
// Parallax scene built on the brand's flint stone artwork: the stone, its glow and floating
// shards move at different depths as the section scrolls through.
interface Props { eyebrow: string; lines: string[] }
import SplitHeading from './SplitHeading.astro';
const { eyebrow, lines } = Astro.props;
---
<section class="flint section" aria-labelledby="flint-title">
  <div class="container split">
    <div class="flint__copy">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <div id="flint-title"><SplitHeading lines={lines} /></div>
      <div data-reveal style="--d:.2s"><slot /></div>
    </div>
    <div class="flint__stage" aria-hidden="true">
      <div class="flint__glow" data-parallax="0.15" data-parallax-scale="0.25"></div>
      <div class="flint__ring" data-parallax="0.05" data-parallax-rotate="40"></div>
      <img
        class="flint__stone"
        data-parallax="-0.12"
        data-parallax-rotate="-6"
        src="/images/flint-stone-800.webp"
        srcset="/images/flint-stone-480.webp 480w, /images/flint-stone-800.webp 800w, /images/flint-stone-1200.webp 1200w"
        sizes="(max-width: 900px) 90vw, 560px"
        width="800" height="800" loading="lazy" decoding="async" alt=""
      />
      <span class="chip chip--1" data-parallax="-0.6" data-parallax-rotate="80"></span>
      <span class="chip chip--2" data-parallax="0.5" data-parallax-rotate="-60"></span>
      <span class="chip chip--3" data-parallax="-0.9" data-parallax-rotate="120"></span>
      <span class="ember ember--1" data-parallax="-1.1"></span>
      <span class="ember ember--2" data-parallax="-0.7"></span>
      <span class="ember ember--3" data-parallax="-1.4"></span>
    </div>
  </div>
</section>
<style>
  .flint { overflow: hidden; }
  .flint__copy :global(.h2) { margin-bottom: 1.5rem; }
  .flint__stage { position: relative; aspect-ratio: 1; max-width: 600px; width: 100%; margin-inline: auto; }
  .flint__stone { position: relative; z-index: 2; width: 100%; height: 100%; object-fit: contain;
    filter: drop-shadow(0 40px 60px rgba(0,0,0,.6)); }
  .flint__glow { position: absolute; inset: 15%; border-radius: 50%; z-index: 1;
    background: radial-gradient(circle, rgba(255,169,18,.55), rgba(255,128,13,.15) 45%, transparent 70%); filter: blur(10px); }
  .flint__ring { position: absolute; inset: 4%; border-radius: 50%; border: 1px dashed rgba(255,128,13,.35); z-index: 0; }
  .chip { position: absolute; z-index: 3; width: 18px; height: 14px; background: #1b1b1b; clip-path: polygon(20% 0, 100% 30%, 80% 100%, 0 70%); box-shadow: inset 0 0 0 1px #333; }
  .chip--1 { left: 8%; top: 20%; } .chip--2 { right: 10%; top: 62%; width: 26px; height: 20px; } .chip--3 { left: 30%; bottom: 8%; width: 12px; height: 10px; }
  .ember { position: absolute; z-index: 3; width: 6px; height: 6px; border-radius: 50%; background: var(--flare); box-shadow: 0 0 12px 3px rgba(255,169,18,.8); }
  .ember--1 { right: 22%; top: 30%; } .ember--2 { left: 40%; top: 50%; width: 4px; height: 4px; } .ember--3 { right: 34%; bottom: 25%; }
</style>
