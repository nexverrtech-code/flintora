---
import Logo from './Logo.astro';
import { site, nav, socialLinks } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo />
        <p class="muted">{site.tagline}. A digital marketing agency for brands that want momentum.</p>
        <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone && <a class="footer-phone muted" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>}
      </div>
      <nav aria-label="Services" class="footer-col">
        <h2 class="footer-h">Services</h2>
        <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul>
      </nav>
      <nav aria-label="Company" class="footer-col">
        <h2 class="footer-h">Company</h2>
        <ul>
          {nav.filter((n) => n.href !== '/services/').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      {socialLinks.length > 0 && (
        <nav aria-label="Social" class="footer-col">
          <h2 class="footer-h">Follow</h2>
          <ul>{socialLinks.map((s) => <li><a href={s.url} rel="noopener me" target="_blank" class="cap">{s.name}</a></li>)}</ul>
        </nav>
      )}
    </div>
    <p class="footer-giant" aria-hidden="true" data-parallax="-0.06">Flintora</p>
    <div class="footer-bottom">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-top: clamp(3.5rem, 2rem + 5vw, 6rem); overflow: hidden; }
  .footer-top { display: grid; gap: 2.5rem; grid-template-columns: 1.6fr repeat(3, 1fr); }
  .footer-brand p { margin: 1.25rem 0; max-width: 34ch; font-size: 0.95rem; }
  .footer-mail { display: inline-block; font-size: var(--step-1); border-bottom: 1px solid var(--spark); }
  .footer-phone { display: block; margin-top: 0.5rem; }
  .footer-h { font-family: var(--font-display); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.14em; color: var(--spark); margin-bottom: 1rem; }
  .footer-col ul, .footer-bottom ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: 0.6rem; }
  .footer-col a, .footer-bottom a { color: var(--muted); font-size: 0.93rem; transition: color 0.3s; }
  .footer-col a:hover, .footer-bottom a:hover { color: var(--text); }
  .cap { text-transform: capitalize; }
  .footer-giant {
    font-family: var(--font-display); text-transform: uppercase; margin: 3rem 0 0;
    font-size: clamp(2.4rem, 11.5vw, 11rem); line-height: 0.85; letter-spacing: 0; text-align: center; white-space: nowrap;
    background: linear-gradient(180deg, rgba(255,255,255,0.09), rgba(255,255,255,0));
    -webkit-background-clip: text; background-clip: text; color: transparent; user-select: none;
  }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1.5rem 0 2rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--dim); }
  .footer-bottom p { margin: 0; }
  .footer-bottom ul { display: flex; gap: 1.5rem; }
  @media (max-width: 900px) { .footer-top { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .footer-top { grid-template-columns: 1fr; } }
</style>
