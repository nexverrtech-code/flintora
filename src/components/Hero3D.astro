---
// Home hero. The static SVG mark renders first (fast LCP, works without WebGL);
// the three.js scene loads after the page is idle and fades in over it.
import SparkMark from './SparkMark.astro';
import Icon from './Icon.astro';
---
<section class="hero" data-hero>
  <div class="hero__stage" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__fallback" data-hero-fallback><SparkMark /></div>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
  </div>
  <div class="container hero__content">
    <p class="eyebrow hero__in" style="--d:.1s">Digital marketing agency</p>
    <h1 class="display hero__title" aria-label="Where ideas spark.">
      <span class="split-line" style="--i:0"><span>Where</span></span>
      <span class="split-line" style="--i:1"><span>ideas</span></span>
      <span class="split-line" style="--i:2"><span class="text-gradient">spark.</span></span>
    </h1>
    <p class="lead hero__in" style="--d:.55s">
      Flintora turns sharp ideas into measurable growth. SEO, performance marketing, social, content, brand and web, run by one team that answers to your numbers.
    </p>
    <div class="hero__actions hero__in" style="--d:.7s">
      <a href="/contact/" class="btn" data-magnetic>Book a strategy call <Icon name="arrow" /></a>
      <a href="/services/" class="btn btn--ghost">See what we do</a>
    </div>
  </div>
  <a href="#intro" class="hero__scroll" aria-label="Scroll to content"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; padding: calc(var(--header-h) + 2rem) 0 5rem; }
  .hero__stage { position: absolute; inset: 0; }
  .hero__glow { position: absolute; right: -15%; top: 50%; translate: 0 -50%; width: 90vw; max-width: 1200px; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,128,13,.25), rgba(255,128,13,.06) 40%, transparent 68%); }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__canvas.is-ready { opacity: 1; }
  .hero__fallback { position: absolute; right: 12%; top: 50%; translate: 0 -50%; width: clamp(180px, 24vw, 340px);
    filter: drop-shadow(0 40px 80px rgba(255,128,13,.45)); transition: opacity .25s; animation: float 6s ease-in-out infinite; }
  .hero__fallback :global(svg) { width: 100%; height: auto; }
  .hero__canvas.is-ready ~ .hero__fallback, .hero[data-3d] .hero__fallback { opacity: 0; }
  @keyframes float { 50% { transform: translateY(-14px) rotate(-2deg); } }

  .hero__content { position: relative; z-index: 2; }
  .hero__title { margin-bottom: 1.75rem; }
  .hero__title .split-line > span { transform: translate3d(0, 110%, 0) skewY(6deg); animation: lineUp 1.2s var(--ease) forwards; animation-delay: calc(.15s + var(--i) * .1s); }
  .hero .lead { max-width: 48ch; }
  .hero__in { opacity: 0; animation: fadeUp 1s var(--ease) forwards; animation-delay: var(--d); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }
  @keyframes lineUp { to { transform: none; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  .hero__scroll { position: absolute; left: 50%; bottom: 1.75rem; width: 26px; height: 42px; translate: -50% 0; border: 1px solid var(--line-strong); border-radius: 20px; z-index: 2; }
  .hero__scroll span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; translate: -50% 0; border-radius: 3px; background: var(--spark); animation: wheel 1.8s var(--ease) infinite; }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  @media (max-width: 900px) {
    .hero { align-items: flex-end; }
    .hero__fallback { right: 50%; translate: 50% 0; top: calc(var(--header-h) + 1rem); width: 130px; }
    .hero__glow { right: 50%; top: 18%; translate: 50% -50%; }
    .hero__content { padding-top: 26vh; }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  if (host && canvas && hasWebGL && !reduce && !saveData) {
    const start = () =>
      import('../scripts/hero3d')
        .then(({ initHero3D }) => {
          initHero3D(canvas, host);
          host.setAttribute('data-3d', '');
        })
        .catch(() => {/* keep the static mark */});
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 400);
  }
</script>
