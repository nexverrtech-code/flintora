---
interface Props { name: 'arrow' | 'plus' | 'mail' | 'phone' | 'whatsapp' | 'menu' | 'close'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'whatsapp' && <path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6L3 21zM9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 1a4 4 0 0 1-2.5-2.5l1-1-1-2L9 8.5z" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
