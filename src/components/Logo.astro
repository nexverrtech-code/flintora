---
import SparkMark from './SparkMark.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['logo', cls]} aria-label="Flintora home">
  <SparkMark class="logo__mark" />
  <span class="logo__word">Flintora</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; }
  .logo__mark { width: 22px; height: auto; transition: transform 0.6s var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-8deg) scale(1.08); }
  .logo__word {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.15rem;
    line-height: 1;
  }
</style>
