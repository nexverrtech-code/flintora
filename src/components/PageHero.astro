---
// Inner page hero: big headline with layered parallax shards of the spark mark behind it.
import SplitHeading from './SplitHeading.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SparkMark from './SparkMark.astro';
interface Props { eyebrow: string; lines: string[]; lead?: string; crumbs?: { label: string; href: string }[] }
const { eyebrow, lines, lead, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <div class="glow" data-parallax="0.25"></div>
    <div class="shard shard--a" data-parallax="-0.35" data-parallax-rotate="18"><SparkMark /></div>
    <div class="shard shard--b" data-parallax="0.45" data-parallax-rotate="-24"><SparkMark mono /></div>
    <div class="grid-lines" data-parallax="0.1"></div>
  </div>
  <div class="container page-hero__inner">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <SplitHeading lines={lines} as="h1" class="h1" />
    {lead && <p class="lead" data-reveal style="--d:.25s">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero { position: relative; padding: calc(var(--header-h) + clamp(3rem, 2rem + 6vw, 7rem)) 0 clamp(3rem, 2rem + 5vw, 6rem); overflow: hidden; border-bottom: 1px solid var(--line); }
  .page-hero__inner { position: relative; z-index: 1; }
  .page-hero .h1 { max-width: 16ch; margin-bottom: 1.5rem; }
  .page-hero .lead { max-width: 52ch; }
  .page-hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .glow { position: absolute; right: -10%; top: -20%; width: 70vw; max-width: 900px; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,128,13,.22), rgba(255,128,13,0) 65%); }
  .shard { position: absolute; }
  .shard :global(svg) { width: 100%; height: auto; }
  .shard--a { right: 4%; top: 20%; width: clamp(100px, 14vw, 210px); filter: drop-shadow(0 30px 60px rgba(255,128,13,.35)); opacity: .9; }
  .shard--b { right: 26%; bottom: -8%; width: clamp(60px, 7vw, 110px); color: rgba(255,255,255,.07); }
  .grid-lines { position: absolute; inset: -20% 0; opacity: .5;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px; mask-image: radial-gradient(ellipse 60% 60% at 70% 40%, #000, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 60% 60% at 70% 40%, #000, transparent 75%); }
  @media (max-width: 1100px) { .shard--a { opacity: .3; right: -4%; } }
</style>
