---
// Sticky scroll section: the step list stays pinned while a progress line fills
// and each step lights up as the visitor scrolls (driven by --progress from motion.ts).
interface Props { steps: { title: string; text: string }[]; eyebrow: string; lines: string[] }
import SplitHeading from './SplitHeading.astro';
const { steps, eyebrow, lines } = Astro.props;
---
<section class="process" data-scroll-progress style={`--count:${steps.length}`}>
  <div class="process__sticky">
    <div class="container process__grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <SplitHeading lines={lines} />
        <div class="process__bar" aria-hidden="true"><span></span></div>
      </div>
      <ol class="process__steps">
        {steps.map((s, i) => (
          <li style={`--n:${i}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .process { --progress: 0; height: calc(100vh + var(--count) * 38vh); position: relative; }
  .process__sticky { position: sticky; top: 0; min-height: 100vh; display: flex; align-items: center; padding: calc(var(--header-h) + 1rem) 0 2rem; }
  .process__grid { display: grid; gap: 3rem; grid-template-columns: 1fr 1.1fr; align-items: center; }
  .process__bar { margin-top: 2.5rem; height: 3px; background: var(--line); max-width: 320px; }
  .process__bar span { display: block; height: 100%; background: var(--spark); transform-origin: left; transform: scaleX(var(--progress)); }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; }
  .process__steps li {
    --on: clamp(0, (var(--progress) * var(--count) - var(--n)) * 3, 1);
    display: grid; grid-template-columns: 70px 1fr; gap: 1rem; padding: 1.4rem 1.5rem; border-radius: var(--radius);
    border: 1px solid var(--line); background: var(--surface);
    opacity: calc(0.3 + var(--on) * 0.7);
    transform: translateX(calc((1 - var(--on)) * 30px));
    border-color: rgb(255 128 13 / calc(var(--on) * 0.45));
  }
  .process__steps p { margin: 0.35rem 0 0; font-size: 0.95rem; }
  @media (max-width: 900px) {
    .process { height: auto; }
    .process__sticky { position: static; min-height: 0; padding-block: 5rem; }
    .process__grid { grid-template-columns: 1fr; }
    .process__steps li { opacity: 1; transform: none; }
    .process__bar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .process { height: auto; }
    .process__sticky { position: static; min-height: 0; padding-block: 5rem; }
    .process__steps li { opacity: 1; transform: none; }
  }
</style>
