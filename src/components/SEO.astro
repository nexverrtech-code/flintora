---
import { site } from '../data/site';
export interface SEOProps {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}
const { title, description, image = '/og-default.png', type = 'website', noindex = false, schema = [], publishedTime, modifiedTime } = Astro.props as SEOProps;
const fullTitle = title === site.name ? `${site.name} | Digital Marketing Agency. ${site.tagline}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const orgId = new URL('/#organization', Astro.site).href;

const sameAs = Object.values(site.social).filter(Boolean);
const address = Object.values(site.address).some(Boolean)
  ? {
      '@type': 'PostalAddress',
      streetAddress: site.address.street || undefined,
      addressLocality: site.address.city || undefined,
      addressRegion: site.address.region || undefined,
      postalCode: site.address.postalCode || undefined,
      addressCountry: site.address.country || undefined,
    }
  : undefined;

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': orgId,
    name: site.name,
    slogan: site.tagline,
    description: site.description,
    url: new URL('/', Astro.site).href,
    logo: new URL('/icon-512.png', Astro.site).href,
    image: ogImage,
    email: site.email,
    telephone: site.phone || undefined,
    address,
    sameAs: sameAs.length ? sameAs : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).href,
    publisher: { '@id': orgId },
  },
];
const allSchema = [...baseSchema, ...schema];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Flintora logo" />
<meta property="og:locale" content="en" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
<script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
