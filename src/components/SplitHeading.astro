---
// Headline whose lines slide up when scrolled into view. Lines are rendered on the server,
// so the text is always present for search engines and no-JS visitors.
interface Props { lines: string[]; as?: 'h1' | 'h2' | 'h3' | 'p'; class?: string; delay?: number }
const { lines, as: Tag = 'h2', class: cls = 'h2', delay = 0 } = Astro.props;
---
<Tag class={cls} data-reveal-split style={delay ? `--d:${delay}s` : undefined}>
  {lines.map((line, i) => (
    <span class="split-line" style={`--i:${i}`}><span>{line}</span>{i < lines.length - 1 && ' '}</span>
  ))}
</Tag>
