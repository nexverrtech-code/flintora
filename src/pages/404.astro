---
import BaseLayout from '../layouts/BaseLayout.astro';
import SparkMark from '../components/SparkMark.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="nf">
    <div class="nf__mark" aria-hidden="true"><SparkMark /></div>
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 class="display">No spark here.</h1>
      <p class="lead">The page you were looking for has moved or never existed. Try one of these instead.</p>
      <div class="nf__links">
        <a href="/" class="btn">Back to home <Icon name="arrow" /></a>
        <a href="/services/" class="btn btn--ghost">Services</a>
        <a href="/contact/" class="btn btn--ghost">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 100svh; display: flex; align-items: center; position: relative; overflow: hidden; padding: calc(var(--header-h) + 3rem) 0 4rem; }
  .nf .display { margin-bottom: 1.5rem; }
  .nf__mark { position: absolute; right: 8%; top: 50%; width: clamp(140px, 22vw, 320px); translate: 0 -50%; opacity: .25; animation: flick 3s steps(1) infinite; }
  .nf__mark :global(svg) { width: 100%; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  @keyframes flick { 0%, 100% { opacity: .25; } 48% { opacity: .05; } 50% { opacity: .3; } 52% { opacity: .08; } }
</style>
