---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);
const all = (await getCollection('blog', ({ data }) => !data.draft)).filter((p) => p.id !== post.id).slice(0, 2);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  mainEntityOfPage: url,
  image: new URL('/og-default.png', Astro.site).href,
  author: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
  publisher: { '@id': new URL('/#organization', Astro.site).href },
}];
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date} modifiedTime={post.data.updated} schema={schema}>
  <article>
    <header class="post-hero">
      <div class="container narrow">
        <Breadcrumbs items={[{ label: 'Insights', href: '/blog/' }, { label: post.data.category, href: `/blog/${post.id}/` }]} />
        <div class="meta" data-reveal>
          <span class="pill">{post.data.category}</span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <span>{post.data.readingTime} min read</span>
        </div>
        <h1 class="title" data-reveal>{post.data.title}</h1>
        <p class="lead" data-reveal>{post.data.description}</p>
      </div>
    </header>
    <div class="container narrow body">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><Content /></div>
      <a href="/blog/" class="link-arrow back">All insights <Icon name="arrow" /></a>
    </div>
  </article>
  {all.length > 0 && (
    <section class="section--tight">
      <div class="container narrow">
        <p class="eyebrow">Keep reading</p>
        <div class="grid grid-2">
          {all.map((p) => (
            <a href={`/blog/${p.id}/`} class="card more">
              <span class="pill">{p.data.category}</span>
              <h2 class="h3">{p.data.title}</h2>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <CTA />
</BaseLayout>
<style>
  .narrow { max-width: calc(880px + var(--gutter) * 2); }
  .post-hero { padding: calc(var(--header-h) + clamp(2.5rem, 2rem + 4vw, 5rem)) 0 2.5rem; border-bottom: 1px solid var(--line);
    background: radial-gradient(60% 80% at 90% 0%, rgba(255,128,13,.14), transparent 70%); }
  .meta { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; font-size: .85rem; color: var(--dim); margin-bottom: 1.5rem; }
  .title { font-weight: 600; font-size: var(--step-3); line-height: 1.12; margin-bottom: 1.25rem; }
  .body { padding-block: 3rem 2rem; }
  .toc { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin-bottom: 2.5rem; background: var(--surface); }
  .toc .eyebrow { margin-bottom: .75rem; }
  .toc ol { margin: 0; padding-left: 1.2rem; color: var(--muted); font-size: .95rem; }
  .toc a:hover { color: var(--spark); }
  .back { margin-top: 2rem; }
  .more { display: grid; gap: .8rem; justify-items: start; }
</style>
