---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const hasKey = Boolean(site.web3formsKey);
const action = hasKey ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`;
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Flintora',
  url: new URL('/contact/', Astro.site).href,
  mainEntity: { '@id': new URL('/#organization', Astro.site).href },
}];
---
<BaseLayout
  title="Contact"
  description="Talk to Flintora about SEO, paid media, social, content, branding or a new website. Book a free strategy call and get honest next steps within one working day."
  schema={schema}
>
  <PageHero
    eyebrow="Contact"
    lines={['Let us', 'talk growth.']}
    lead="Tell us a little about your business and what you want to achieve. We reply within one working day."
    crumbs={[{ label: 'Contact', href: '/contact/' }]}
  />
  <section class="section">
    <div class="container contact">
      <form
        class="form card"
        method="POST"
        action={action}
        enctype={hasKey ? undefined : 'text/plain'}
        data-contact-form
        data-mode={hasKey ? 'api' : 'mailto'}
        data-email={site.email}
        novalidate
      >
        {hasKey && (
          <>
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New enquiry from flintora website" />
            <input type="hidden" name="from_name" value="Flintora website" />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </>
        )}
        <div class="row">
          <div class="field">
            <label for="name">Your name *</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Work email *</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="company">Company or website</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="service">What do you need help with?</label>
            <select id="service" name="service">
              <option value="">Not sure yet</option>
              {services.map((s) => <option value={s.slug}>{s.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="budget">Monthly budget</label>
            <select id="budget" name="budget">
              <option value="">Prefer not to say</option>
              <option>Under 1,000 USD</option>
              <option>1,000 to 5,000 USD</option>
              <option>5,000 to 15,000 USD</option>
              <option>15,000 USD or more</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="message">Tell us about your goals *</label>
          <textarea id="message" name="message" required minlength="10"></textarea>
        </div>
        <label class="consent-check">
          <input type="checkbox" name="consent" required />
          <span>I agree to Flintora storing my details to reply to this enquiry, as described in the <a href="/privacy-policy/">privacy policy</a>.</span>
        </label>
        <button type="submit" class="btn submit">Send message <Icon name="arrow" /></button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>

      <aside class="side">
        <div class="side__block" data-reveal>
          <p class="eyebrow">Email</p>
          <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        {site.phone && (
          <div class="side__block" data-reveal>
            <p class="eyebrow">Phone</p>
            <a class="big" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
          </div>
        )}
        <div class="side__block" data-reveal>
          <p class="eyebrow">What happens next</p>
          <ol class="next">
            <li>We read your message and reply within one working day.</li>
            <li>A 30 minute call to understand your goals and numbers.</li>
            <li>A short written plan with priorities, timeline and cost.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .form { display: grid; gap: 1.25rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .hp { position: absolute; left: -9999px; }
  .consent-check { display: grid; grid-template-columns: 20px 1fr; gap: .75rem; font-size: .88rem; color: var(--muted); align-items: start; }
  .consent-check input { width: 18px; height: 18px; margin-top: .2rem; accent-color: var(--spark); }
  .consent-check a { color: var(--spark); text-decoration: underline; }
  .submit { justify-self: start; }
  .submit[disabled] { opacity: .6; pointer-events: none; }
  .status { margin: 0; min-height: 1.5em; font-size: .95rem; }
  .status.is-ok { color: #6ee7a8; }
  .status.is-err { color: #fca5a5; }
  .field.has-error input, .field.has-error textarea { border-color: #f87171; }
  .side { display: grid; gap: 2.5rem; }
  .side__block .eyebrow { margin-bottom: .6rem; }
  .big { font-size: var(--step-1); border-bottom: 1px solid var(--spark); word-break: break-all; }
  .next { margin: 0; padding-left: 1.2rem; color: var(--muted); display: grid; gap: .6rem; }
  .next li::marker { color: var(--spark); font-weight: 600; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const select = form.querySelector<HTMLSelectElement>('#service')!;
    const pre = new URLSearchParams(location.search).get('service');
    if (pre && [...select.options].some((o) => o.value === pre)) select.value = pre;

    const setStatus = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = `status ${ok ? 'is-ok' : 'is-err'}`;
    };

    const validate = () => {
      let firstBad: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const bad = !el.checkValidity();
        el.closest('.field')?.classList.toggle('has-error', bad);
        el.setAttribute('aria-invalid', String(bad));
        if (bad && !firstBad) firstBad = el;
      });
      if (firstBad) {
        (firstBad as HTMLElement).focus();
        setStatus('Please fill in the required fields, use a valid email and tick the consent box.', false);
        return false;
      }
      return true;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const data = new FormData(form);

      if (form.dataset.mode === 'mailto') {
        const body = ['name', 'email', 'phone', 'company', 'service', 'budget', 'message']
          .map((k) => `${k[0].toUpperCase() + k.slice(1)}: ${data.get(k) ?? ''}`)
          .join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('New enquiry from the Flintora website')}&body=${encodeURIComponent(body)}`;
        setStatus('Your email app should open with your message ready to send.', true);
        return;
      }

      btn.disabled = true;
      setStatus('Sending...', true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success !== false) {
          form.reset();
          setStatus('Thank you. Your message is on its way and we will reply within one working day.', true);
        } else {
          throw new Error(json.message || 'Request failed');
        }
      } catch {
        setStatus(`Sorry, something went wrong. Please email us at ${form.dataset.email}.`, false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
